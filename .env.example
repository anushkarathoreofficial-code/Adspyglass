# Copy to .env.local and fill in the parts you want live. Each is independent.

# Gemini API key — powers the Competitor spy's LIVE trend research (Reddit /
# Quora / web) via Google Search grounding. Get one at https://aistudio.google.com/apikey
# Without it the spy still works; the "Live trend research" panel just prompts to add this.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# --- Google login gate (Auth.js) ---
# Restricts the whole app to approved Google accounts so nobody can burn your
# paid API credits. Create an OAuth client at console.cloud.google.com →
# APIs & Services → Credentials → OAuth client ID (type: Web application).
# Authorized redirect URI must be: https://<your-domain>/api/auth/callback/google
AUTH_SECRET=              # any random 32+ char string: `openssl rand -base64 32`
GOOGLE_CLIENT_ID=         # from the OAuth client
GOOGLE_CLIENT_SECRET=     # from the OAuth client
# Allowlist — set at least one in production, else ANY Google account can sign in:
ALLOWED_EMAILS=           # comma-separated, e.g. you@astrotalk.com, teammate@astrotalk.com
ALLOWED_EMAIL_DOMAIN=     # or a whole domain, e.g. astrotalk.com

# Ad Library data provider — powers REAL-TIME ad fetching in the Competitor spy
# (Meta's own API can't return US commercial ads; this is a 3rd-party provider).
# Get a key at https://scrapecreators.com. Without it the spy uses the harvested
# corpus. Results auto-sync every 7h; "Sync now" forces a fresh pull.
SCRAPECREATORS_API_KEY=
